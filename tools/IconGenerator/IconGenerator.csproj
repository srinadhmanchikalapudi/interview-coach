<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draws the app icon from vector shapes and writes app.ico plus logo PNGs into the folder given as the only argument.
       It is not part of the solution. The README explains how to run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
