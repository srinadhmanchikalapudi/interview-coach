<UserControl x:Class="InterviewCoach.App.Views.MockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:InterviewCoach.App.Controls">
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding Composer.ToggleMicCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RepeatCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- The status pill: Speaking, Listening, Thinking or Your turn -->
        <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource AccentChip}">
            <Setter Property="Padding" Value="14,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="Listening">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="Your turn">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClockText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOvertime}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HiddenWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" MaxWidth="900">

            <!-- Top bar: who is talking, the clock, and End interview -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource StatusPill}" Margin="0,0,16,0" AutomationProperties.Name="Interview status">
                    <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" Style="{StaticResource ClockText}" VerticalAlignment="Center" AutomationProperties.Name="Elapsed and target time" />
                <CheckBox Grid.Column="2" Content="Show the interviewer's words" IsChecked="{Binding ShowQuestionText}" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
                <Button Grid.Column="3" Command="{Binding EndInterviewCommand}" Padding="16,7" Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="End interview" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Text="{Binding RoleLine}" Style="{StaticResource Hint}" Margin="0,0,0,2" />
            <TextBlock Text="{Binding OvertimeText}" Style="{StaticResource HiddenWhenEmpty}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,2,0,0" />
            <TextBlock Margin="0,0,0,14" Style="{StaticResource Hint}" Text="Nothing here is graded. Your feedback comes after the interview." />

            <!-- Planning the round -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsPlanning, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" />
                    <TextBlock Text="Planning the round from your resume and the job description…" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Something went wrong. The conversation so far is kept. -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                    Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="Something went wrong" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}" Text="The conversation so far is kept." />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Retry" Command="{Binding RetryCommand}" Padding="22,7" />
                        <Button Content="Back to Home" Command="{Binding ExitCommand}" Padding="18,7" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Writing the debrief -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsWrappingUp, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" />
                    <TextBlock Text="That was the interview. Writing your debrief…" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- The interviewer -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16" Visibility="{Binding HasInterviewerLine, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource BrandGradient}" CornerRadius="10,0,0,10" />
                    <StackPanel Grid.Column="1" Margin="26,20,26,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE77B;" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="INTERVIEWER" Margin="0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding InterviewerLine}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="32"
                                   AutomationProperties.Name="Interviewer" />
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,14,0,0" Width="120" HorizontalAlignment="Left"
                                     Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}" />
                        <Button Command="{Binding RepeatCommand}" Padding="14,6" Margin="0,14,0,0" HorizontalAlignment="Left" ToolTip="Hear the last line again"
                                Visibility="{Binding HasSpeech, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Repeat" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Voice trouble: said in words, the text stays, typing still works -->
            <Border Style="{StaticResource InsetCard}" Margin="0,0,0,12" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    Visibility="{Binding HasSpeechNotice, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SpeechNotice}" TextWrapping="Wrap" />
            </Border>

            <!-- Your answer -->
            <Border Style="{StaticResource Card}" IsEnabled="{Binding CanAnswerNow}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="YOUR ANSWER" VerticalAlignment="Center" Margin="0" />
                    </StackPanel>

                    <TextBox x:Name="AnswerBox" Text="{Binding AnswerText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="360" FontSize="15"
                             VerticalScrollBarVisibility="Auto" ctl:WheelScrolling.PassToPage="True"
                             AutomationProperties.Name="Your answer" SelectionChanged="AnswerBox_SelectionChanged">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SubmitCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- What the microphone is hearing, before it is put into the box -->
                    <TextBlock Text="{Binding Composer.PartialText, StringFormat='… {0}'}" Style="{StaticResource Hint}" FontStyle="Italic" Margin="0,8,0,0"
                               Visibility="{Binding Composer.HasPartial, Converter={StaticResource BoolToVis}}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding EmptyMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding HasEmptyMessage, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding WordCountText}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            <TextBlock Text="  ·  " Style="{StaticResource Hint}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AnswerTimerText}" Style="{StaticResource Hint}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Speech trouble from the microphone -->
                    <Border Style="{StaticResource InsetCard}" Margin="0,12,0,0" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            Visibility="{Binding Composer.HasSpeechMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Composer.SpeechMessage}" TextWrapping="Wrap" />
                    </Border>

                    <WrapPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Command="{Binding SubmitCommand}" Padding="28,9" Style="{DynamicResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Send" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE724;" FontSize="12" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding Composer.ToggleMicCommand}" Padding="16,9" Margin="10,0,0,0" AutomationProperties.Name="Dictate your answer"
                                ToolTip="Dictate your answer (F2). Talking over the interviewer stops them."
                                Visibility="{Binding HasSpeech, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Composer.MicGlyph}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Composer.MicLabel}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding Composer.ListeningStatus}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="{Binding Composer.IsListening, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Ctrl+Enter to send." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- The conversation so far (no feedback in it) -->
            <Expander Header="Conversation so far" Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding Conversation}" Margin="4,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                <Run Text="{Binding Speaker, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Text, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
