<UserControl x:Class="InterviewCoach.App.Views.PracticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:InterviewCoach.App.Controls">
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding ToggleMicCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- The timer turns amber and then red on long behavioral and project answers -->
        <Style x:Key="TimerText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTimerAmber}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTimerRed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,28" MaxWidth="900">

                <!-- What this is, and what the question is about -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="15" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="PRACTICE" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource Chip}" Visibility="{Binding HasQuestion, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding TypeLabel}" FontSize="12" />
                        </Border>
                        <Border Style="{StaticResource AccentChip}" Visibility="{Binding HasTechnology, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Technology}" FontSize="12" />
                        </Border>
                    </StackPanel>
                    <Border Style="{StaticResource Chip}" Visibility="{Binding HasAttemptLabel, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding AttemptLabel}" FontSize="12" />
                    </Border>
                </StackPanel>

                <TextBlock Visibility="{Binding IsFollowUp, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="Follow-up to: " /><Run Text="{Binding ParentQuestion, Mode=OneWay}" />
                </TextBlock>

                <!-- The question -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,18" Visibility="{Binding HasQuestion, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource BrandGradient}" CornerRadius="10,0,0,10" />
                        <TextBlock Grid.Column="1" Text="{Binding Question}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="36" Margin="26,24,26,24" />
                    </Grid>
                </Border>

                <!-- Choosing a question -->
                <Border Style="{StaticResource Card}" Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" />
                        <TextBlock Text="Choosing a question that fits your resume and the job…" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Something went wrong. The question and any answer stay on screen. -->
                <Border Style="{StaticResource Card}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="Something went wrong" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Hint}" Text="Your answer is kept." Visibility="{Binding FailedAfterAnswer, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Retry" Command="{Binding RetryCommand}" Padding="22,7" />
                            <Button Content="Edit my answer" Command="{Binding EditAnswerCommand}" Padding="18,7" Margin="10,0,0,0"
                                    Visibility="{Binding FailedAfterAnswer, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The answer box. Nothing is coached until Submit. -->
                <Border Style="{StaticResource Card}" Visibility="{Binding IsAnswering, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource CardTitle}" Text="YOUR ANSWER" VerticalAlignment="Center" Margin="0" />
                            </StackPanel>
                            <Button Content="Start from my last answer" Command="{Binding UsePreviousAnswerCommand}" HorizontalAlignment="Right" Padding="12,4"
                                    Visibility="{Binding CanUsePreviousAnswer, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <TextBox x:Name="AnswerBox" Text="{Binding AnswerText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" MaxHeight="420" FontSize="15"
                                 VerticalScrollBarVisibility="Auto" ctl:WheelScrolling.PassToPage="True"
                                 AutomationProperties.Name="Your answer" SelectionChanged="AnswerBox_SelectionChanged">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SubmitCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- What the microphone is hearing, before it is put into the box -->
                        <TextBlock Text="{Binding PartialText, StringFormat='… {0}'}" Style="{StaticResource Hint}" FontStyle="Italic" Margin="0,8,0,0"
                                   Visibility="{Binding HasPartial, Converter={StaticResource BoolToVis}}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding EmptyMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding HasEmptyMessage, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding WordCountText}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <TextBlock Text="  ·  " Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TimerText}" Style="{StaticResource TimerText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Speech trouble: said in words, the text stays, typing still works -->
                        <Border Style="{StaticResource InsetCard}" Margin="0,12,0,0" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                Visibility="{Binding HasSpeechMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SpeechMessage}" TextWrapping="Wrap" />
                        </Border>

                        <WrapPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Command="{Binding SubmitCommand}" Padding="28,9" Style="{DynamicResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Submit" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE724;" FontSize="12" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleMicCommand}" Padding="16,9" Margin="10,0,0,0" AutomationProperties.Name="Dictate your answer"
                                    ToolTip="Dictate your answer (F2). You can type and talk in the same box."
                                    Visibility="{Binding HasSpeech, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding MicGlyph}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding MicLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RepeatQuestionCommand}" Padding="14,9" Margin="10,0,0,0" ToolTip="Hear the question again"
                                    AutomationProperties.Name="Repeat the question"
                                    Visibility="{Binding HasSpeech, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Repeat" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding ListeningStatus}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Ctrl+Enter to submit. You get feedback only after you submit." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- The answer that was sent -->
                <Border Style="{StaticResource Card}" Visibility="{Binding ShowSubmittedAnswer, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource CardTitle}" Text="YOUR ANSWER" VerticalAlignment="Center" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="{Binding SubmittedMeta}" Style="{StaticResource Hint}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding SubmittedAnswer}" TextWrapping="Wrap" FontSize="15" LineHeight="23" />
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsCoaching, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,10" />
                            <TextBlock Text="Reading your answer…" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Feedback and the model answer -->
                <ContentControl Content="{Binding Coach}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding ExitCommand}" Padding="18,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="12" Margin="0,0,9,0" />
                        <TextBlock Text="Back to Home" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding TryAgainCommand}" Padding="18,8" Margin="0,0,10,0"
                            Visibility="{Binding IsFeedback, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="12" Margin="0,0,9,0" />
                            <TextBlock Text="Try again" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NextCommand}" Padding="26,8" Style="{DynamicResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Next question" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" FontSize="12" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
