<UserControl x:Class="InterviewCoach.App.Views.LearnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,28" MaxWidth="900">

                <!-- What this is, and what the question is about -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE82F;" FontSize="15" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="LEARN" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource Chip}" Visibility="{Binding HasQuestion, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding TypeLabel}" FontSize="12" />
                        </Border>
                        <Border Style="{StaticResource AccentChip}" Visibility="{Binding HasTechnology, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Technology}" FontSize="12" />
                        </Border>
                        <TextBlock Text="{Binding Focus}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Visibility="{Binding IsFollowUp, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="Follow-up to: " /><Run Text="{Binding ParentQuestion, Mode=OneWay}" />
                </TextBlock>

                <!-- The question -->
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,18"
                        Visibility="{Binding HasQuestion, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource BrandGradient}" CornerRadius="10,0,0,10" />
                        <TextBlock Grid.Column="1" Text="{Binding Question}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="36" Margin="26,24,26,24" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource InsetCard}" Margin="0,0,0,16" Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,6" Text="HINT FROM THE PREVIOUS ANSWER" />
                        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="15" />
                    </StackPanel>
                </Border>

                <!-- Progress -->
                <Border Style="{StaticResource Card}" Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" />
                        <TextBlock Text="Choosing a question that fits your resume and the job…" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Visibility="{Binding IsLoadingAnswer, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" />
                        <TextBlock Text="Writing a model answer from your resume…" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Error with Retry; the question stays on screen -->
                <Border Style="{StaticResource Card}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="Something went wrong" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
                        <Button Content="Retry" Command="{Binding RetryCommand}" Padding="22,7" Margin="0,12,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- A general (resume-free) answer can be rewritten from the resume on request -->
                <Border Style="{StaticResource Card}" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        Visibility="{Binding IsGenericAnswer, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="18" VerticalAlignment="Top" Margin="0,2,14,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding GenericAnswerNote}" TextWrapping="Wrap" />
                            <Button Content="Tailor to my resume" Command="{Binding PersonalizeCommand}" Padding="20,7" Margin="0,12,0,0" HorizontalAlignment="Left"
                                    Visibility="{Binding CanTailor, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource Hint}" Text="Writes a new answer from your resume and the job description. It is not saved for reuse."
                                       Visibility="{Binding CanTailor, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Coach output cards -->
                <ContentControl Content="{Binding Coach}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding ExitCommand}" Padding="18,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="12" Margin="0,0,9,0" />
                        <TextBlock Text="Back to Home" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding BackCommand}" Padding="18,8" Margin="0,0,10,0"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Back to the main question" />
                    </Button>
                    <Button Command="{Binding TryItMyselfCommand}" Padding="18,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="12" Margin="0,0,9,0" />
                            <TextBlock Text="Try it myself" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NextCommand}" Padding="26,8" Style="{DynamicResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Next question" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" FontSize="12" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
