<UserControl x:Class="InterviewCoach.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:InterviewCoach.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Success}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HiddenWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,24" MaxWidth="820">

                <StackPanel Margin="0,0,0,22">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Connect your language model and tune how the app behaves." />
                </StackPanel>

                <!-- ===== Language model ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Language model" Style="{StaticResource CardHeading}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,16" Text="Questions and coaching come from this provider. Your key is stored encrypted for your Windows account." />

                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Provider" />
                            <ComboBox ItemsSource="{Binding Providers}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Provider}" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsAnthropic, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Anthropic API key" />
                            <PasswordBox ctl:PasswordBoxBinder.BoundPassword="{Binding AnthropicApiKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding AnthropicKeyHint}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsOpenAi, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="OpenAI API key" />
                            <PasswordBox ctl:PasswordBoxBinder.BoundPassword="{Binding OpenAiApiKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding OpenAiKeyHint}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsOpenRouter, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="OpenRouter API key" />
                            <PasswordBox ctl:PasswordBoxBinder.BoundPassword="{Binding OpenRouterApiKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding OpenRouterKeyHint}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="One key works for every model OpenRouter offers. You pay OpenRouter from your credit balance; you choose the model below. Create a key at openrouter.ai/keys." />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsOpenAi, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Base URL (leave empty for api.openai.com)" />
                            <TextBox Text="{Binding OpenAiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Hint}" Text="For example http://localhost:11434/v1 for Ollama. Local servers do not need a key." />
                        </StackPanel>

                        <!-- ===== Recommended setups ===== -->
                        <ItemsControl ItemsSource="{Binding SetupCards}" Margin="0,0,0,6"
                                      Visibility="{Binding HasSetupCards, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetCard}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                                <TextBlock Text="{Binding TestedNote}" Style="{StaticResource Hint}" Margin="10,2,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,2,0,10" />
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,5" ToolTip="{Binding Why}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="140" />
                                                                <ColumnDefinition Width="250" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Role}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ModelId}" FontWeight="SemiBold" Margin="0,0,16,0" />
                                                            <TextBlock Grid.Column="2" Text="{Binding PriceNote}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="Use this setup" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Padding="16,6" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,10" FontSize="13" FontWeight="SemiBold" Text="Model for each role" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Planner" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding ModelSuggestions}" Text="{Binding PlannerModel, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Interviewer" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding ModelSuggestions}" Text="{Binding InterviewerModel, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />
                                <TextBlock Style="{StaticResource Hint}" Text="Spoken live, so speed matters. Try a faster, smaller model if it feels slow." />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Question generator" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding ModelSuggestions}" Text="{Binding QuestionGeneratorModel, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />
                                <TextBlock Style="{StaticResource Hint}" Text="Replies are short, so a fast, inexpensive model works well." />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Coach" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding ModelSuggestions}" Text="{Binding CoachModel, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />
                                <TextBlock Style="{StaticResource Hint}" Text="Quality matters most here. Use your strongest model if quality matters more than cost." />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Debrief" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding ModelSuggestions}" Text="{Binding DebriefModel, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- ===== OpenRouter: choose a model from the catalog ===== -->
                        <Border Style="{StaticResource InsetCard}" Margin="0,4,0,14"
                                Visibility="{Binding IsOpenRouter, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Choose a model" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,10"
                                           Text="Load the list, search it, pick a model, then say which role should use it. A cheaper model for the question generator and a stronger one for the coach is a good mix. You can also type any model name in the boxes above." />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Command="{Binding LoadModelsCommand}" Padding="16,7" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Load models" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Search" VerticalAlignment="Center" Margin="16,0,8,0" Style="{StaticResource Hint}" />
                                    <TextBox Text="{Binding ModelFilter, UpdateSourceTrigger=PropertyChanged}" Width="240"
                                             VerticalAlignment="Center" ToolTip="Search by name or id, for example: claude, gemini flash, deepseek" />
                                    <CheckBox Content="Cheapest first" IsChecked="{Binding CheapestFirst}" Margin="14,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Hint}" Text="{Binding CatalogStatus}" Margin="0,0,0,8" />

                                <ListBox ItemsSource="{Binding CatalogModels}" SelectedItem="{Binding SelectedCatalogModel}"
                                         Height="260" Margin="0,0,0,10"
                                         Visibility="{Binding HasCatalog, Converter={StaticResource BoolToVis}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,3">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Id}" Style="{StaticResource Hint}" />
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasCatalog, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Use the selected model for" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Content="Question generator" Command="{Binding UseForQuestionGeneratorCommand}" Padding="12,6" Margin="0,0,8,0" />
                                    <Button Content="Coach" Command="{Binding UseForCoachCommand}" Padding="12,6" Margin="0,0,8,0" />
                                    <Button Content="Every role" Command="{Binding UseForAllRolesCommand}" Padding="12,6" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                            <Button Command="{Binding TestConnectionCommand}" Padding="18,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE9F5;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Test connection" />
                                </StackPanel>
                            </Button>
                            <Button Content="Cancel" Command="{Binding TestConnectionCancelCommand}" Padding="16,7" Margin="8,0,0,0"
                                    Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TestResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Style="{StaticResource ResultText}" Text="{Binding Icon}" Width="22" FontWeight="Bold" />
                                        <TextBlock Style="{StaticResource ResultText}" Text="{Binding Message}" MaxWidth="640" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== Speed and cost ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Speed and cost" Style="{StaticResource CardHeading}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,16" Text="Two switches that make answers arrive sooner and cost less." />

                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Thinking effort (Anthropic and OpenRouter)" />
                            <ComboBox ItemsSource="{Binding ThinkingEfforts}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding ThinkingEffort}" MinWidth="260" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Newer models think before they answer, and that can be most of the wait. Lower effort means less thinking, so replies should arrive sooner. Ignored for Haiku models. With OpenRouter it is sent as OpenRouter's own reasoning setting; models that always think (such as Claude Sonnet 5.5) default to high there, so Low is worth setting. If a model rejects the setting, Test connection will say so; switch back to Model default." />
                        </StackPanel>

                        <StackPanel>
                            <CheckBox Content="Use prompt caching (Anthropic)" IsChecked="{Binding PromptCaching}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Your resume and job description make up most of each request. With caching on, repeat requests within about five minutes reuse them at roughly a tenth of the normal input price. Not used through OpenRouter. Turn it off only if a model rejects it." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Saved technical questions ===== -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasBank, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Saved technical questions" Style="{StaticResource CardHeading}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,14"
                                   Text="Technical-concept questions are saved per technology (found in your job description) and seniority, with a general answer written without your resume. They stay valid when you edit your resume or job description, and reusing one costs no tokens. Every answer has a Tailor to my resume button." />
                        <CheckBox Content="Reuse saved general answers for technical-concept questions" IsChecked="{Binding ReuseGeneralAnswers}" />
                        <Border Style="{StaticResource InsetCard}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding BankStats}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Grid.Column="1" Command="{Binding ClearBankCommand}" Padding="16,6" Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Clear saved questions and answers" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== Speech ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Speech" Style="{StaticResource CardHeading}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,16"
                                   Text="Dictate your answers and hear the questions in Practice. The Windows voice needs no key. The OpenAI choices use the OpenAI key above." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Speech to text" />
                                <ComboBox ItemsSource="{Binding SttProviders}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SpeechToText}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Text to speech" />
                                <ComboBox ItemsSource="{Binding TtsProviders}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TextToSpeech}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Azure Speech key" />
                            <PasswordBox ctl:PasswordBoxBinder.BoundPassword="{Binding AzureSpeechKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding AzureKeyHint}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Azure Speech region (for example westeurope)" />
                            <TextBox Text="{Binding AzureSpeechRegion, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Voice (leave empty for the default one)" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Voices}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding Voice}"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Voice" />
                                <Button Grid.Column="1" Content="Load voices" Command="{Binding LoadVoicesCommand}" Padding="14,6" Margin="10,0,0,0" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Voice, StringFormat='Saved voice: {0}'}" Visibility="{Binding HasVoice, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding SpeakingRate, StringFormat='Speaking rate: {0:0.0}x'}" />
                            <Slider Minimum="0.5" Maximum="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding SpeakingRate}" Width="300" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test voice" Command="{Binding TestVoiceCommand}" Padding="16,7" />
                            <Button Content="{Binding MicTestLabel}" Command="{Binding TestMicCommand}" Padding="16,7" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding SpeechStatus}" Visibility="{Binding HasSpeechStatus, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- ===== Behavior ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Behavior" Style="{StaticResource CardHeading}" Margin="0,0,0,14" />
                        <CheckBox Content="Speak each Practice question aloud" IsChecked="{Binding SpeakQuestions}" Margin="0,0,0,8" />
                        <CheckBox Content="Auto-listen: start the mic when the interviewer finishes speaking" IsChecked="{Binding AutoListen}" Margin="0,0,0,8" />
                        <CheckBox Content="Silence auto-submit" IsChecked="{Binding SilenceAutoSubmit}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="28,0,0,8" IsEnabled="{Binding SilenceAutoSubmit}">
                            <TextBlock Text="Submit after" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding SilenceSeconds, UpdateSourceTrigger=LostFocus}" Width="60" />
                            <TextBlock Text="seconds of silence (after at least 10 words)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <CheckBox Content="Show question text by default in Mock Interview" IsChecked="{Binding ShowQuestionTextDefault}" />
                    </StackPanel>
                </Border>

                <!-- ===== About and updates ===== -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="About and updates" Style="{StaticResource CardHeading}" />
                        <TextBlock Text="{Binding VersionText}" Margin="0,6,0,0" AutomationProperties.Name="Version" />
                        <CheckBox Content="Look for a new version when the program starts (once a day at most)" IsChecked="{Binding CheckForUpdates}" Margin="0,14,0,0" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="This asks GitHub only for the number of the latest release. Nothing about you or your sessions is sent. Updates are never installed without your say-so." />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Check for updates now" Command="{Binding CheckForUpdatesNowCommand}" IsEnabled="{Binding CanCheckNow}" Padding="16,7" />
                            <Button Content="{Binding InstallUpdateText}" Command="{Binding InstallUpdateCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,7" Margin="10,0,0,0"
                                    Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Open the releases page" Command="{Binding OpenReleasePageCommand}" Padding="16,7" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="{Binding HasUpdateStatus, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- ===== Other ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Other" Style="{StaticResource CardHeading}" Margin="0,0,0,14" />
                        <CheckBox Content="Demo mode (fake language model and speech, no keys needed)" IsChecked="{Binding DemoMode}" Margin="0,0,0,8" />
                        <CheckBox Content="Debug logging (writes prompts and replies to %LOCALAPPDATA%\InterviewCoach\logs)" IsChecked="{Binding DebugLogging}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Debug logs include your resume and job description, so leave this off unless you are troubleshooting." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding SaveCommand}" Padding="24,8" Style="{DynamicResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="18,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{StaticResource HiddenWhenEmpty}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
