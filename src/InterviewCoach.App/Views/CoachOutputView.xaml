<UserControl x:Class="InterviewCoach.App.Views.CoachOutputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:InterviewCoach.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Section heading used by every card: an icon and a small title -->
        <Style x:Key="CardIcon" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,-10,9,0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="FeedbackIcon" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="strength">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="fix">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="missing">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 1. What they are testing -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE721;" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="WHAT THEY'RE TESTING" />
                </StackPanel>
                <TextBlock Text="{Binding WhatTheyreTesting}" TextWrapping="Wrap" FontSize="15" LineHeight="23" />
            </StackPanel>
        </Border>

        <!-- 2. How your answer landed (empty in Learn mode, so hidden) -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE90A;" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="HOW YOUR ANSWER LANDED" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Feedback}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FeedbackIcon}" Text="{Binding Icon}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock TextWrapping="Wrap" FontSize="15">
                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Point, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Quote, StringFormat='“{0}”'}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding HasQuote, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 3. The strong answer, said out loud: the card the eye should land on -->
        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource BrandGradient}" CornerRadius="10,0,0,10" />
                <StackPanel Grid.Column="1" Margin="24,20,24,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource CardIcon}" Text="&#xE720;" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="A STRONG ANSWER, SAID OUT LOUD" />
                    </StackPanel>
                    <ctl:HighlightedTextBlock HighlightedText="{Binding ModelAnswer}" TextWrapping="Wrap" FontSize="18" LineHeight="30" />
                    <Button Command="{Binding ReadAloudCommand}" Padding="14,6" Margin="0,14,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding CanReadAloud, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ReadAloudLabel}" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource InsetCard}" Margin="0,18,0,0" Padding="14,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding LengthSummary}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0" Text="{Binding ExpectationText}"
                                       Visibility="{Binding HasExpectation, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="Highlighted [brackets] are not from your resume. A bracketed number is a realistic suggestion: keep it only if it is true for you, or replace it with your real figure. Any other bracket is a detail for you to fill in." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. The shape of it -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasShape, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8FD;" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="THE SHAPE OF IT" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ShapeSteps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="14" Padding="13,5">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="11" Margin="8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding ShowArrow, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 5. Delivery (only when the answer was spoken or timed) -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasDelivery, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE916;" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="DELIVERY" />
                </StackPanel>
                <TextBlock Text="{Binding Delivery}" TextWrapping="Wrap" FontSize="15" />
            </StackPanel>
        </Border>

        <!-- 6. Where they will go next -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasFollowUps, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8F2;" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="WHERE THEY'LL GO NEXT" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding FollowUps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="12" Margin="16,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding FollowUpPrompt}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
