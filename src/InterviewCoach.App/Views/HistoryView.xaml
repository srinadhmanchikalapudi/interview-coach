<UserControl x:Class="InterviewCoach.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- The signal badge: red for a no, green for a yes, neutral between; amber for a round that is not complete -->
        <Style x:Key="StatusBadge" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPositive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNegative}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFinished}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" MaxWidth="900">
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="History" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Your mock interviews. Pick one up where you left it, or open its debrief." />
                </StackPanel>
                <Button Command="{Binding OpenLibraryCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="14,7"
                        ToolTip="Questions you learned and answers you practised">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F1;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Open the Library" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- A result of the last action, or a problem with it -->
            <Border Style="{StaticResource InsetCard}" Margin="0,0,0,14" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.Name="History notice" />
            </Border>
            <Border Style="{StaticResource Card}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            </Border>

            <!-- Nothing yet -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="No mock interviews yet" Style="{StaticResource CardHeading}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="Start a Mock Interview from Home. It appears here as it goes, so a round you leave can be picked up again, and each finished one keeps its debrief." />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding CountText}" Style="{StaticResource Hint}" Margin="0,0,0,8" Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}" />

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0">
                                        <Run Text="{Binding RoundText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ElapsedText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource StatusBadge}" VerticalAlignment="Center" AutomationProperties.Name="Status">
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Open debrief" Command="{Binding OpenCommand}" Padding="16,6" Style="{DynamicResource AccentButtonStyle}"
                                            Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="{Binding ResumeLabel}" Command="{Binding ResumeCommand}" Padding="16,6" Style="{DynamicResource AccentButtonStyle}"
                                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" />
                                    <Button Command="{Binding DeleteCommand}" Padding="10,6" Margin="8,0,0,0" ToolTip="Delete this interview" AutomationProperties.Name="Delete">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
