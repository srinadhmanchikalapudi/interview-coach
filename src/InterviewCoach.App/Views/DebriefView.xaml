<UserControl x:Class="InterviewCoach.App.Views.DebriefView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- The hire signal badge: red for a no, green for a yes, neutral between -->
        <Style x:Key="SignalBadge" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPositive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNegative}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HiddenWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,28" MaxWidth="900">

                <TextBlock Text="Your debrief" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding RoleLine}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,20" />

                <!-- 1. The summary and the signal -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" FontSize="14" Margin="0,0,9,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource CardTitle}" Text="HOW THE ROUND WENT" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Style="{StaticResource SignalBadge}" HorizontalAlignment="Right" AutomationProperties.Name="Hire signal">
                                <TextBlock Text="{Binding SignalLabel}" FontWeight="SemiBold" FontSize="14" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="16" LineHeight="25" />
                    </StackPanel>
                </Border>

                <!-- 2. The focus areas -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasRatings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="FOCUS AREAS" />
                        <ItemsControl ItemsSource="{Binding Ratings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="4" Value="{Binding Rating, Mode=OneWay}" Height="8" VerticalAlignment="Center" Margin="12,0"
                                                         Visibility="{Binding Covered, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding RatingText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 3. Strengths -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasStrengths, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="STRENGTHS" />
                        <ItemsControl ItemsSource="{Binding Strengths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#x2713;" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="15" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 4. Top fixes -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasFixes, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="TOP FIXES" />
                        <ItemsControl ItemsSource="{Binding Fixes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Fix}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Hint}" Visibility="{Binding HasExample, Converter={StaticResource BoolToVis}}">
                                            <Run Text="Where it showed up: " FontWeight="SemiBold" /><Run Text="{Binding Example, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Hint}" Visibility="{Binding HasHowToPractice, Converter={StaticResource BoolToVis}}">
                                            <Run Text="How to practise: " FontWeight="SemiBold" /><Run Text="{Binding HowToPractice, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 5. Practise next -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasPracticeNext, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="PRACTISE NEXT" />
                        <ItemsControl ItemsSource="{Binding PracticeNext}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#x2022;" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="15" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 6. Question by question -->
                <TextBlock Text="Question by question" Style="{StaticResource SectionHeader}" Margin="0,8,0,4" Visibility="{Binding HasThreads, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" Text="The coaching for each question is written while the debrief is, so some cards may still be filling in."
                           Visibility="{Binding IsStillCoaching, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Threads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <Expander IsExpanded="False" Padding="0">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" MaxWidth="620" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Chip}" Margin="12,0,0,0" Visibility="{Binding IsCoaching, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Coaching…" FontSize="12" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Margin="12,0,0,0" Visibility="{Binding IsNotAnswered, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Not answered" FontSize="12" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Margin="12,0,0,0" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Coaching failed" FontSize="12" />
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,14,0,0">
                                        <ItemsControl ItemsSource="{Binding Turns}" Margin="0,0,0,14">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontSize="14">
                                                        <Run Text="{Binding Speaker, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Text, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Error, StringFormat='The coaching for this question could not be written: {0}'}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Button Content="Try again" Command="{Binding RetryCommand}" Padding="16,5" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsCoaching, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" />
                                            <TextBlock Text="Writing the coaching for this question…" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <ContentControl Content="{Binding Coach}" />

                                        <Button Command="{Binding PracticeCommand}" Padding="18,7" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="13" Margin="0,0,8,0" />
                                                <TextBlock Text="Practise this question" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding BackCommand}" Padding="18,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="12" Margin="0,0,9,0" />
                        <TextBlock Text="Back to Home" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding ExportStatus}" Margin="18,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{StaticResource HiddenWhenEmpty}" />
                <Button Grid.Column="2" Command="{Binding ExportCommand}" Padding="22,8" Style="{DynamicResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="13" Margin="0,0,9,0" />
                        <TextBlock Text="Export to Markdown" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
