<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyTitle>Interview Coach</AssemblyTitle>
    <Product>Interview Coach</Product>
    <Company>srinadhmanchikalapudi</Company>
    <Copyright>Copyright (c) 2026 srinadhmanchikalapudi. MIT License.</Copyright>
    <Description>Prepare for a specific job interview: learn, practise and mock interviews built from your resume and the job description.</Description>
    <RepositoryUrl>https://github.com/srinadhmanchikalapudi/interview-coach</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- ThemeMode (Windows 11 Fluent look, follows the system light/dark setting) is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <!-- The icon is also needed inside the app: the window and the sidebar use these files. -->
  <ItemGroup>
    <Resource Include="Assets/app.ico" />
    <Resource Include="Assets/logo-64.png" />
    <Resource Include="Assets/logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InterviewCoach.Core\InterviewCoach.Core.csproj" />
    <ProjectReference Include="..\InterviewCoach.Infrastructure\InterviewCoach.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Prompts ship next to the exe so they can be tweaked without recompiling (Infrastructure embeds a fallback copy). -->
  <ItemGroup>
    <None Update="Prompts\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
